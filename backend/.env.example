# ============ Asset Portal backend (ONE server for every portal) ============
# Copy this file to ".env" (or just run:  npm run setup) and fill the marked values.
NODE_ENV=development
PORT=4000

# 1) DATABASE  (MySQL / Hostinger). Create the database + user in hPanel -> Databases first.
#    If the password has symbols, URL-encode them (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# 2) SECRETS  (filled automatically by:  npm run setup)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
HALMS_JWT_SECRET=

# 3) THE SUPER ADMIN  (one account, works for BOTH the client panel and the candidate panel)
#    Password: at least 12 characters.
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# 4) Web addresses (change only when you deploy)
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

ACCESS_TTL=15m
REFRESH_TTL=7d
HALMS_JWT_EXPIRES_IN=8h

# Optional: e-mail (leave empty to skip), online payments (Razorpay), bond length
# Emails (forgot password, interview invitations). Leave SMTP_HOST empty and the emails are printed in the backend window instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<a Google App password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Asset Portal <no-reply@example.com>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BOND_MONTHS=12

# ---- AI Assistant (client chatbot) ----
# Leave empty = "Guided help" mode (works with no key, English + Hinglish, answers from the built-in guide).
# Add a key = real AI answers. Get a key at console.anthropic.com. NEVER put this key in the frontend.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5

# Time zone for walk-in drives and "today" (default Asia/Kolkata). Change only if you work in another country.
# WALKIN_TZ=Asia/Kolkata
